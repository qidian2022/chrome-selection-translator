{
  "manifest_version": 3,
  "name": "划词译 · OpenAI 中文翻译",
  "version": "1.2.1",
  "description": "选中文字，点击翻译，在当前网页查看中文译文。使用你自己的 OpenAI API 密钥。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "划词译"},
  "options_page": "options.html",
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["client.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],
  "commands": {"translate-selection": {
    "suggested_key": {"default": "Alt+Shift+T", "mac": "Alt+Shift+T"},
    "description": "把选中文字翻译成中文"
  }}
}
